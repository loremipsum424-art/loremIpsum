cw_bin = compute_class_weight(class_weight="balanced", classes=np.unique(y_bin_train), y=y_bin_train)
class_weight_bin = {i: w for i, w in zip(np.unique(y_bin_train), cw_bin)}

cw_multi = compute_class_weight(class_weight="balanced", classes=np.unique(y_multi_train), y=y_multi_train)
class_weight_multi = {i: w for i, w in zip(np.unique(y_multi_train), cw_multi)}

# =========================
# Binary model training
# =========================
binary_model = build_model(X_bin_train.shape[1], 2)
binary_model.compile(
    optimizer=make_optimizer(train_ds_bin, MAX_EPOCHS),
    loss=focal_loss if USE_FOCAL_LOSS else tf.keras.losses.CategoricalCrossentropy(label_smoothing=LABEL_SMOOTHING),
    metrics=["accuracy"],
)

# NOTE: ReduceLROnPlateau intentionally excluded — see header comment.
callbacks_bin = [
    EarlyStopping(monitor="val_loss", patience=PATIENCE, restore_best_weights=True),
    ModelCheckpoint(os.path.join(OUTPUT_DIR, "best_binary.keras"), monitor="val_loss", save_best_only=True, verbose=1),
]

history_bin = binary_model.fit(
    train_ds_bin, validation_data=val_ds_bin, epochs=MAX_EPOCHS,
    class_weight=class_weight_bin, callbacks=callbacks_bin, verbose=1,
)

binary_loaded = tf.keras.models.load_model(
    os.path.join(OUTPUT_DIR, "best_binary.keras"),
    custom_objects={
        "TransformerBlock": TransformerBlock,
        "NumericFeatureTokenizer": NumericFeatureTokenizer,
        "focal_loss": focal_loss,
        "WarmupCosine": WarmupCosine,
    },
    compile=False,
)

bin_pred, bin_prob = evaluate(binary_loaded, test_ds_bin, y_test_bin, ["Normal", "Attack"], "BINARY")
plot_history(history_bin, "Binary Classification", "binary_history")

